# ── HTM backend — DEVELOP environment ────────────────────────────────────────
# Copy to  backend/.env.development  on the dev/test server and fill real values.
# Isolated from testing & production by DB_NAME + S3_PREFIX + JWT_SECRET.

NODE_ENV=production
PORT=4000

# Database — points at the shared MySQL container, DEV schema
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-strong-root-password
DB_NAME=fmapp_dev

# Auth — MUST be unique per environment
JWT_SECRET=change-me-unique-develop-secret

# First-run super admin (optional)
ROOT_USERNAME=admin
ROOT_PASSWORD=change-me

# CORS / public URLs for this environment
ALLOW_ORIGIN=https://dev.htm.catalystservices.eco
API_BASE_URL=https://dev.htm.catalystservices.eco

# ── S3 — SAME bucket as prod, isolated by prefix (dev/…) ──────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=catalysthtmappuploads
AWS_ACCESS_KEY_ID=copy-from-prod-or-a-scoped-key
AWS_SECRET_ACCESS_KEY=copy-from-prod-or-a-scoped-key
AWS_S3_URL_EXPIRY=3600
S3_PREFIX=dev

# ── Optional integrations (leave blank to disable in dev) ─────────────────────
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v20.0
